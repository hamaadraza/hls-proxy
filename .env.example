# Public origin that rewritten playlist URLs point at.
# Leave unset to derive it from each request's Host header (handy locally).
BASE_URL=https://hls-proxy.example.com

BIND=0.0.0.0
PORT=8080

# Browser fingerprint used for upstream requests. Any wreq-util profile works
# (chrome_137, chrome_136, firefox_136, safari_18, edge_134, ...).
DEFAULT_EMULATION=chrome_137

# Platform the profile presents as: windows, macos, linux, android, ios.
DEFAULT_EMULATION_OS=windows

# Route upstream requests (playlists and segments) through an HTTP/HTTPS proxy.
# Useful when one provider rate-limits (429s) a single source IP. Credentials in
# the URL are sent as Proxy-Authorization; leave unset for direct connections.
# A malformed value fails at startup.
# PROXY_URL=http://USERNAME:PASSWORD@185.135.11.34:6033

# How the proxy is used (only meaningful when PROXY_URL is set):
#   always   - every request goes through the proxy (default).
#   fallback - go direct until a host returns 429, then route just that host
#              through the proxy until it cools off. Lower latency for live HLS,
#              since the proxy hop is only paid when actually rate-limited.
# PROXY_MODE=fallback

RUST_LOG=hls_proxy=info,tower_http=warn
